/* ==========================================================================
   TABD - THE AVENUE BUILDERS & DEVELOPERS
   Redesign Reference: Avenue25 (avenue25.com.my)
   Preserving 100% of TABD identity, data, content, and functionality.
   ========================================================================== */

/* --------------------------------------------------------------------------
   0. CSS CUSTOM PROPERTIES / DESIGN TOKENS (Avenue25 Palette & Typography)
   -------------------------------------------------------------------------- */
:root {
  /* Softer, Refined, Harmonious Color Palette */
  --color-sand: #d8d3c7;          /* Soft linen beige */
  --color-sand-light: #faf9f6;    /* Light, warm alabaster for crisp clean backgrounds */
  --color-stone: #aba399;         /* Neutral warm stone */
  --color-forest: #2b4537;        /* Refined, softer botanical forest green */
  --color-forest-dark: #1b2c23;   /* Gentle deep woodland shade (replaces harsh black) */
  --color-gold: #bfa176;          /* Muted champagne brass */
  --color-gold-light: #ecdcc7;    /* Gentle warm highlight */
  --color-charcoal: #2c302d;      /* Soft dark charcoal */
  --color-dark: #202422;          /* Softer rich dark for headings */
  --color-body: #505652;          /* Softer, legible body reading contrast */
  --color-white: #ffffff;
  --color-border: rgba(32, 36, 34, 0.08);
  --color-border-light: rgba(255, 255, 255, 0.14);
  
  /* Fonts */
  --font-display: 'Philosopher', 'Playfair Display', Georgia, serif;
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  
  /* Avenue25 Spacing & Layout Tokens */
  --header-height: 84px;
  --container-max: 1240px;
  --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-fast: all 0.25s ease;
}

/* --------------------------------------------------------------------------
   1. BASE RESET & ESSENTIALS
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-sans);
  color: var(--color-body);
  background-color: var(--color-white);
  line-height: 1.7;
  overflow-x: hidden;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition-fast);
}

button {
  cursor: pointer;
  border: none;
  background: none;
  font-family: inherit;
}

/* --------------------------------------------------------------------------
   2. AVENUE25 BUTTON STYLES & CTA
   -------------------------------------------------------------------------- */
/* Avenue25 .cta-rectangle: Elegant outlined box button with word expansion */
.cta-rectangle,
.btn-primary,
.btn-secondary {
  display: inline-block;
  padding: 14px 34px;
  border: 1px solid var(--color-white);
  color: var(--color-white);
  font-family: var(--font-sans);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 4px;
  text-transform: uppercase;
  text-align: center;
  background: transparent;
  position: relative;
  transition: var(--transition);
  cursor: pointer;
}

.cta-rectangle:hover,
.btn-primary:hover {
  background-color: var(--color-white);
  color: var(--color-dark);
  letter-spacing: 5px;
  border-color: var(--color-white);
}

.cta-rectangle.dark,
.btn-secondary {
  border: 1px solid var(--color-dark);
  color: var(--color-dark);
}

.cta-rectangle.dark:hover,
.btn-secondary:hover {
  background-color: var(--color-dark);
  color: var(--color-white);
  letter-spacing: 5px;
}

.cta-underline {
  display: inline-block;
  position: relative;
  font-size: 0.88rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-weight: 600;
  padding-bottom: 6px;
  color: var(--color-white);
}

.cta-underline::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 1px;
  background-color: currentColor;
  transition: var(--transition);
}

.cta-underline:hover {
  letter-spacing: 4px;
}

.cta-underline.black {
  color: var(--color-dark);
}

/* --------------------------------------------------------------------------
   3. AVENUE25 FLOATING MINIMAL HEADER & SLIDE MENU
   -------------------------------------------------------------------------- */
#header,
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  padding: 24px 40px;
  transition: var(--transition);
  pointer-events: none;
}

#header.scrolled,
.site-header.scrolled {
  background: rgba(18, 28, 23, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 16px 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.menu-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  pointer-events: auto;
}

.menu-logo {
  max-width: 190px;
}

.menu-logo img,
.brand-logo-img {
  width: 100%;
  height: auto;
  max-height: 48px;
  object-fit: contain;
}

/* Desktop horizontal menu links */
.desktop-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
}

@media (max-width: 1024px) {
  .desktop-nav {
    display: none;
  }
}

.desktop-nav a {
  color: var(--color-white);
  font-size: 0.8rem;
  letter-spacing: 3.5px;
  text-transform: uppercase;
  font-weight: 500;
  opacity: 0.9;
  position: relative;
  padding: 6px 0;
}

.desktop-nav a:hover,
.desktop-nav a.active {
  opacity: 1;
  color: var(--color-gold-light);
}

.desktop-nav a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 1px;
  background-color: var(--color-gold-light);
  transition: width 0.3s ease;
}

.desktop-nav a:hover::after,
.desktop-nav a.active::after {
  width: 100%;
}

/* Avenue25 Quick Action CTA */
.header-right-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.btn-header-enquire {
  display: inline-block;
  padding: 10px 22px;
  background-color: rgba(27, 44, 35, 0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(191, 161, 118, 0.55);
  color: var(--color-white);
  font-size: 0.75rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-weight: 600;
  border-radius: 3px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  transition: var(--transition);
}

.btn-header-enquire:hover {
  background-color: var(--color-forest);
  color: var(--color-white);
  border-color: var(--color-gold);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
}

/* Mobile Menu Enquire Container (Hidden by default on Desktop) */
.menu-mobile-enquire {
  display: none;
}

/* Avenue25 3-line luxury hamburger */
.menu-cta-menu-hamburger {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  position: relative;
  width: 44px;
  height: 44px;
  cursor: pointer;
  z-index: 10;
  gap: 5px;
  padding: 8px 6px;
  transition: transform 0.3s ease;
}

.menu-cta-menu-hamburger span {
  display: block;
  background-color: #ffffff;
  height: 2px;
  border-radius: 2px;
  transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, transform 0.3s ease;
}

.menu-cta-menu-hamburger span:nth-child(1) {
  width: 26px;
}

.menu-cta-menu-hamburger span:nth-child(2) {
  width: 19px;
}

.menu-cta-menu-hamburger span:nth-child(3) {
  width: 24px;
}

.menu-cta-menu-hamburger:hover span {
  background-color: var(--color-gold-light);
  width: 26px;
}

/* ==========================================================================
   SPLIT-PANEL LUXURY NAVIGATION DRAWER (#headerMenuSlide)
   Inspired by Reference Image 1 & Pinterest Motion Reference:
   - Left Panel: Deep earthy olive background, logo, numbered indices 01-05,
     elegant serif typography, thin horizontal separators, sequential staggered reveals
   - Right Panel: Architectural image background, sleek [✕ CLOSE] trigger,
     warm bronze/terracotta action pills ("START WITH A FLOOR PLAN", "TALK TO OUR TEAM"),
     and official Avenue contact meta details
   ========================================================================== */
#headerMenuSlide {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  max-width: 860px;
  height: 100vh;
  height: 100dvh;
  background-color: #2b3026;
  z-index: 1000000;
  transform: translateX(100%);
  visibility: hidden;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s step-end, box-shadow 0.6s ease;
  box-shadow: -24px 0 60px rgba(0, 0, 0, 0.5);
  overflow-y: auto;
  overflow-x: hidden;
  will-change: transform;
}

#headerMenuSlide.open {
  transform: translateX(0);
  visibility: visible;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s, box-shadow 0.6s ease;
}

.menu-split-grid {
  display: grid;
  grid-template-columns: 1.18fr 0.92fr;
  min-height: 100%;
  height: 100%;
}

/* --------------------------------------------------
   LEFT PANEL: Numbered Navigation & Brand Identity
   -------------------------------------------------- */
.menu-panel-nav {
  background-color: #2e3328;
  padding: 48px 42px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
  z-index: 2;
}

.menu-nav-top {
  margin-bottom: 28px;
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

#headerMenuSlide.open .menu-nav-top {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.1s;
}

.menu-slide-brand {
  margin-bottom: 8px;
}

.menu-slide-brand img {
  max-height: 42px;
  width: auto;
  filter: brightness(0) invert(1);
  display: block;
}

.menu-nav-tagline {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--color-gold);
  font-weight: 600;
  margin-top: 6px;
}

/* Navigation List with 01-05 Index Numbers */
.menu-list {
  list-style: none;
  margin: 0;
  padding: 0;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.menu-item {
  margin: 0;
  padding: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.menu-item:first-child {
  border-top: 1px solid rgba(255, 255, 255, 0.09);
}

/* Staggered kinetic reveal inspired by Pinterest motion */
#headerMenuSlide.open .menu-item {
  opacity: 1;
  transform: translateY(0);
}

#headerMenuSlide.open .menu-item:nth-child(1) { transition-delay: 0.14s; }
#headerMenuSlide.open .menu-item:nth-child(2) { transition-delay: 0.20s; }
#headerMenuSlide.open .menu-item:nth-child(3) { transition-delay: 0.26s; }
#headerMenuSlide.open .menu-item:nth-child(4) { transition-delay: 0.32s; }
#headerMenuSlide.open .menu-item:nth-child(5) { transition-delay: 0.38s; }

#headerMenuSlide:not(.open) .menu-item {
  opacity: 0;
  transform: translateY(12px);
  transition-duration: 0.2s;
  transition-delay: 0s;
}

.menu-link {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 16px 0;
  text-decoration: none;
  position: relative;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-idx {
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 2px;
  color: var(--color-gold);
  opacity: 0.85;
  min-width: 26px;
  transition: color 0.3s ease, opacity 0.3s ease;
}

.nav-title {
  font-family: var(--font-display);
  font-size: clamp(1.2rem, 1.8vw, 1.55rem);
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #f7f5f0;
  font-weight: 400;
  transition: color 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.menu-link:hover {
  transform: translateX(8px);
}

.menu-link:hover .nav-title {
  color: var(--color-gold-light);
}

.menu-link:hover .nav-idx {
  color: var(--color-gold-light);
  opacity: 1;
}

.menu-link.active .nav-title {
  color: var(--color-gold);
  font-weight: 600;
}

.menu-link.active .nav-idx {
  color: var(--color-gold);
  font-weight: 600;
  opacity: 1;
}

.menu-panel-nav-footer {
  margin-top: 28px;
  padding-top: 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.45s ease, transform 0.45s ease;
}

#headerMenuSlide.open .menu-panel-nav-footer {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.42s;
}

.menu-subtext {
  font-size: 0.76rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.55);
  margin: 0;
  line-height: 1.5;
}

/* --------------------------------------------------
   RIGHT PANEL: Architectural Visual, Action Pills & Contact
   -------------------------------------------------- */
.menu-panel-action {
  position: relative;
  background-color: #242920;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.menu-action-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: brightness(0.6) saturate(0.8);
  transform: scale(1.05);
  transition: transform 8s cubic-bezier(0.25, 1, 0.5, 1);
  z-index: 1;
}

#headerMenuSlide.open .menu-action-bg {
  transform: scale(1);
}

.menu-action-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(25, 33, 24, 0.78) 0%,
    rgba(20, 27, 20, 0.88) 50%,
    rgba(16, 22, 16, 0.94) 100%
  );
  z-index: 2;
}

.menu-action-header {
  position: relative;
  z-index: 3;
  padding: 36px 36px 0 36px;
  display: flex;
  justify-content: flex-end;
}

/* Sleek Pill Close Button [✕ CLOSE] */
.menu-close-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 24px;
  padding: 8px 18px;
  color: #ffffff;
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 2.2px;
  text-transform: uppercase;
  opacity: 0;
  transform: scale(0.92);
  transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
}

#headerMenuSlide.open .menu-close-trigger {
  opacity: 1;
  transform: scale(1);
  transition-delay: 0.12s;
}

.menu-close-trigger:hover {
  background: rgba(197, 168, 128, 0.25);
  border-color: var(--color-gold);
  color: var(--color-gold-light);
  transform: scale(1.03);
}

.menu-close-trigger .close-symbol {
  font-size: 1.15rem;
  line-height: 1;
}

.menu-action-body {
  position: relative;
  z-index: 3;
  padding: 24px 36px 40px 36px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* Action Pills (Inspired by Reference Image 1) */
.menu-action-pills {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 28px;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

#headerMenuSlide.open .menu-action-pills {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.4s;
}

.action-pill {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 13px 22px;
  border-radius: 30px;
  text-decoration: none;
  font-family: var(--font-sans);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background-color 0.3s ease;
}

.action-pill .pill-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Primary Terracotta/Warm Bronze Pill */
.action-pill.pill-primary {
  background: #b56e3b;
  color: #ffffff;
  box-shadow: 0 4px 18px rgba(181, 110, 59, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.action-pill.pill-primary:hover {
  background: #c87c44;
  transform: translateY(-2px);
  box-shadow: 0 6px 22px rgba(181, 110, 59, 0.5);
}

/* Secondary Golden Bronze Pill */
.action-pill.pill-secondary {
  background: #966e44;
  color: #ffffff;
  box-shadow: 0 4px 18px rgba(150, 110, 68, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.action-pill.pill-secondary:hover {
  background: #a97e50;
  transform: translateY(-2px);
  box-shadow: 0 6px 22px rgba(150, 110, 68, 0.45);
}

/* Official Avenue Contact Meta Block */
.menu-action-contact {
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  padding-top: 22px;
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

#headerMenuSlide.open .menu-action-contact {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.48s;
}

.contact-eyebrow {
  display: block;
  font-size: 0.68rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--color-gold);
  font-weight: 700;
  margin-bottom: 12px;
}

.contact-meta-row {
  margin-bottom: 7px;
  font-size: 0.8rem;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.85);
}

.contact-meta-label {
  display: inline-block;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1.5px;
  font-size: 0.72rem;
  margin-right: 6px;
}

.contact-meta-val a {
  color: #ffffff;
  text-decoration: none;
  transition: color 0.25s ease;
}

.contact-meta-val a:hover {
  color: var(--color-gold);
}

/* Overlay */
#overlaySlide {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.68);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 999999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

#overlaySlide.open {
  opacity: 1;
  pointer-events: auto;
}

/* Responsive Split-Panel (< 840px) */
@media (max-width: 840px) {
  #headerMenuSlide {
    max-width: 100%;
  }

  .menu-split-grid {
    grid-template-columns: 1fr;
    height: auto;
    min-height: 100%;
  }

  .menu-panel-nav {
    padding: 36px 28px 24px 28px;
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .menu-action-header {
    padding: 24px 28px 0 28px;
  }

  .menu-action-body {
    padding: 20px 28px 40px 28px;
  }
}

/* ==========================================================================
   MOBILE HEADER & NAVIGATION RESPONSIVE FIX (max-width: 768px)
   - Removes ENQUIRE NOW from visible mobile header to eliminate overlap
   - Ensures Avenue logo and hamburger icon have ample spacing and never collide
   - Displays the same ENQUIRE NOW button neatly inside the hamburger navigation menu
   - Strictly keeps desktop view intact (> 768px)
   ========================================================================== */
@media (max-width: 768px) {
  /* 1. Mobile Header: CONTACT pill button */
  #header .header-right-actions .btn-header-enquire,
  .site-header .header-right-actions .btn-header-enquire {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.45) !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border-radius: 9999px !important;
    padding: 5px 14px !important;
    color: #ffffff !important;
    font-size: 0.68rem !important;
    font-weight: 700 !important;
    letter-spacing: 1px !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    box-shadow: none !important;
  }

  .btn-enquire-desktop {
    display: none !important;
  }

  .btn-contact-mobile {
    display: inline !important;
  }

  #headerMenuSlide .btn-enquire-desktop {
    display: inline !important;
  }

  #headerMenuSlide .btn-contact-mobile {
    display: none !important;
  }

  /* 2. Mobile Header spacing: logo, pill button, and hamburger neatly aligned */
  #header,
  .site-header {
    padding: 16px 20px;
  }

  #header.scrolled,
  .site-header.scrolled {
    padding: 12px 20px;
  }

  .menu-logo {
    max-width: 135px;
    flex-shrink: 0;
  }

  .menu-logo img,
  .brand-logo-img {
    max-height: 36px;
    width: auto;
  }

  .header-right-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .menu-cta-menu-hamburger {
    width: 32px;
    height: 32px;
    padding: 6px 2px;
    gap: 5px;
    justify-content: center;
  }

  .menu-cta-menu-hamburger span {
    width: 22px !important;
