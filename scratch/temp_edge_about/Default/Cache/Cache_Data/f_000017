/* --------------------------------------------------------------------------
   3a. AVENUE LOGO OPENING INTRO (#avenue-intro)
   Pre-cloud animated ink-stroke drawing, color sweep, and dissolution
   -------------------------------------------------------------------------- */
#avenue-intro {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgb(241 234 218);
  animation: avi-exit 750ms cubic-bezier(0.65, 0, 0.35, 1) 3200ms forwards;
  pointer-events: auto;
  overflow: hidden;
}

#avenue-intro.fade-out,
#avenue-intro[data-intro="skip"] {
  display: none !important;
}

#avenue-intro .avi-mark {
  position: relative;
  aspect-ratio: 1400 / 596;
  width: clamp(230px, 24vw, 400px);
  animation: avi-mark-out 488ms cubic-bezier(0.4, 0, 0.2, 1) 3200ms forwards;
}

#avenue-intro .avi-ink {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  animation: avi-fade 250ms ease 2950ms forwards;
}

#avenue-intro .avi-logo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  -webkit-mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
  mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
  -webkit-mask-size: 250% 100%;
  mask-size: 250% 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: 100% 0;
  mask-position: 100% 0;
  animation: avi-sweep 750ms cubic-bezier(0.45, 0, 0.2, 1) 2250ms forwards;
}

#avenue-intro .avi-piece {
  animation: avi-settle var(--dur) cubic-bezier(0.2, 0.7, 0.2, 1) var(--at) both;
}

#avenue-intro .avi-stroke {
  stroke-dasharray: 1 2;
  animation: avi-draw var(--dur) cubic-bezier(0.6, 0.05, 0.25, 1) var(--at) both;
}

@keyframes avi-draw {
  from { stroke-dashoffset: 1; }
  to { stroke-dashoffset: 0; }
}

@keyframes avi-settle {
  from { transform: translateY(var(--sy)); }
  to { transform: none; }
}

@keyframes avi-sweep {
  to {
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
  }
}

@keyframes avi-fade {
  to { opacity: 0; }
}

@keyframes avi-mark-out {
  to {
    opacity: 0;
    transform: translateY(-10px);
  }
}

@keyframes avi-exit {
  0% {
    opacity: 1;
    background-color: rgb(241 234 218 / 1);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }
  99% {
    opacity: 0;
    background-color: rgb(241 234 218 / 0);
    -webkit-backdrop-filter: blur(0px);
    backdrop-filter: blur(0px);
    visibility: visible;
  }
  100% {
    opacity: 0;
    background-color: rgb(241 234 218 / 0);
    -webkit-backdrop-filter: blur(0px);
    backdrop-filter: blur(0px);
    visibility: hidden;
    pointer-events: none;
  }
}

@keyframes avi-exit-reduced {
  to { opacity: 0; visibility: hidden; }
}

@media (prefers-reduced-motion: reduce) {
  #avenue-intro {
    animation: avi-exit-reduced 400ms ease 1000ms forwards;
  }
  #avenue-intro .avi-ink {
    display: none;
  }
  #avenue-intro .avi-mark,
  #avenue-intro .avi-logo {
    animation: none;
    -webkit-mask-image: none;
    mask-image: none;
  }
}

/* --------------------------------------------------------------------------
   3b. CINEMATIC CLOUD OPENING INTRO (#cloudIntro)
   Atmospheric, cloudy, smoky natural dissolve revealing hero video
   -------------------------------------------------------------------------- */
.cloud-intro-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  z-index: 999;
  overflow: hidden;
  pointer-events: auto;
  opacity: 1;
  visibility: visible;
  background-color: transparent;
  transition: opacity 1.0s cubic-bezier(0.25, 1, 0.5, 1), visibility 1.0s ease;
  will-change: opacity, visibility;
}

.cloud-intro-visual {
  position: absolute;
  top: -4%;
  left: -4%;
  width: 108%;
  height: 108%;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  filter: blur(0px) brightness(1);
  will-change: transform, filter, opacity;
  animation: cloudAtmosphericDrift 10s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  transition: filter 1.0s cubic-bezier(0.25, 1, 0.5, 1),
              transform 1.0s cubic-bezier(0.25, 1, 0.5, 1);
}

.cloud-intro-smoke {
  position: absolute;
  inset: -2%;
  background: radial-gradient(
    ellipse at 28% 32%,
    rgba(255, 215, 140, 0.16) 0%,
    rgba(230, 235, 245, 0.06) 45%,
    rgba(40, 52, 65, 0.18) 100%
  );
  mix-blend-mode: soft-light;
  pointer-events: none;
  filter: blur(0px);
  will-change: opacity, filter;
  transition: opacity 1.0s cubic-bezier(0.25, 1, 0.5, 1), filter 1.0s ease;
}

/* Dissolve state: clouds softly soften and diffuse like dispersing vapor */
.cloud-intro-screen.fade-out {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.cloud-intro-screen.fade-out .cloud-intro-visual {
  filter: blur(12px) brightness(1.05);
  transform: scale(1.05) translate3d(-0.8%, -0.4%, 0);
}

.cloud-intro-screen.fade-out .cloud-intro-smoke {
  opacity: 0;
  filter: blur(10px);
}

@keyframes cloudAtmosphericDrift {
  0% {
    transform: scale(1) translate3d(0, 0, 0);
  }
  100% {
    transform: scale(1.04) translate3d(-0.8%, -0.4%, 0);
  }
}

/* Accessibility: Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  .cloud-intro-screen {
    transition: opacity 1.5s ease, visibility 1.5s ease !important;
  }
  .cloud-intro-visual,
  .cloud-intro-smoke {
    animation: none !important;
    transform: none !important;
    filter: none !important;
    transition: none !important;
  }
  .cloud-intro-screen.fade-out .cloud-intro-visual,
  .cloud-intro-screen.fade-out .cloud-intro-smoke {
    filter: none !important;
    transform: none !important;
  }
}

