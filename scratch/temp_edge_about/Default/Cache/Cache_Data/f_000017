/* ==========================================================================
   STATIC PREMIUM ENQUIRY FORM (#tabdContactForm & .contact-form-panel)
   Inspired by Reference Image 2:
   - Deep dark teal/slate container card with soft rounded corners (18px)
   - Translucent rounded inputs with subtle borders (8px radius)
   - Clean vertical alignment and muted slate labels
   - Elegant gold/sand submit button
   - STRICT CONSTRAINT: ZERO ANIMATIONS, ZERO TRANSITIONS, COMPLETELY STATIC
   ========================================================================== */
.contact-form-panel {
  background: #111f26;
  padding: 44px 38px;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  box-shadow: 0 24px 55px rgba(8, 18, 22, 0.45);
  position: relative;
  /* STRICTLY STATIC: ABSOLUTELY ZERO ANIMATIONS OR TRANSITIONS */
  transition: none !important;
  animation: none !important;
  transform: none !important;
  opacity: 1 !important;
}

.contact-form-header {
  margin-bottom: 24px;
  transition: none !important;
  animation: none !important;
  transform: none !important;
}

.contact-form-header .heading-eyebrow {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  font-weight: 600;
  color: #729aa7;
  margin-bottom: 6px;
  transition: none !important;
  transform: none !important;
}

.contact-form-header .form-title {
  font-family: var(--font-display);
  font-size: 1.65rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #ffffff;
  margin-bottom: 6px;
  line-height: 1.25;
  transition: none !important;
  transform: none !important;
}

.contact-form-header .form-subtitle {
  color: #7b94a0;
  font-size: 0.9rem;
  line-height: 1.55;
  margin: 0;
  transition: none !important;
  transform: none !important;
}

.form-group {
  position: relative;
  margin-bottom: 18px;
  transition: none !important;
  animation: none !important;
  transform: none !important;
}

.form-row-dual {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  transition: none !important;
  transform: none !important;
}

@media (max-width: 580px) {
  .form-row-dual {
    grid-template-columns: 1fr;
    gap: 0;
  }
}

.form-group label {
  display: block;
  font-size: 0.78rem;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  font-weight: 600;
  color: #8ba2ab;
  margin-bottom: 7px;
  /* STATIC: NO TRANSITIONS */
  transition: none !important;
  transform: none !important;
  animation: none !important;
}

.form-group label .required-mark {
  color: var(--color-gold);
  margin-left: 2px;
  font-weight: 700;
}

.input-wrap {
  position: relative;
  width: 100%;
  transition: none !important;
  transform: none !important;
}

/* Ensure no animated underline or pseudo elements */
.input-wrap::after,
.input-wrap::before {
  display: none !important;
  content: none !important;
}

.form-control {
  width: 100%;
  padding: 13px 16px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  font-family: var(--font-sans);
  font-size: 0.92rem;
  color: #ffffff;
  line-height: 1.4;
  /* STATIC: NO TRANSITIONS */
  transition: none !important;
  animation: none !important;
  transform: none !important;
}

.form-control::placeholder {
  color: #5f7a85;
  font-size: 0.88rem;
  font-weight: 400;
}

.form-control:focus {
