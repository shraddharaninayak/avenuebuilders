  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 220px;
  background-image: url('assets/about-pillar-right-seamless.png');
  background-repeat: repeat-y;
  background-position: right top;
  background-size: 220px auto;
  pointer-events: none;
  z-index: 1;
